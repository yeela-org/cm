manifest:
  version: 1.0

triggers:
  exclude:
    branch:
      - r/renovate\/.*/
config:
  admin:
    users: ['yeelali14']

automations:
  ai_code_review:
    if:
      - true
    run:
      - action: code-review@v1
  multi_org_check:
    if:
      - true
    run:
      - action: add-label@v1
        args:
          label: sanity
      - action: add-comment@v1
        args:
          comment: |
            pasha check result `{{ pasha_check }}`.

  formatting_check:
    if:
      - {{ source.diff.files | isFormattingChange }}
    run:
      - action: add-label@v1
        args:
          label: code-formatting

pasha_check: {{ pr.title | hasBannedWord }}
