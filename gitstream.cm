manifest:
  version: 1.0

triggers:
  exclude:
    branch:
      - r/renovate\/.*/
config:
  admin:
    users: ['yeelali14']

automations:
  multi_org_check:
    if:
      - true
    run:
      - action: add-label@v1
        args:
          label: sanity
      - action: add-comment@v1
        args:
          comment: |
            pasha check result `{{ pasha_check }}`.

pasha_check: {{ pr.title | hasBannedWord }}
